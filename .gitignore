__pycache__/
*.pyc
.env

# tablasDESI/: the raw fastspec-iron VAC is DESI's own data product, not
# duplicated here -- only the directory skeleton is tracked.
/tablasDESI/*.fits

# TABLAS/PARENT/: PARENT{0,1,2,3,4}.fits are real, complete, and otherwise
# exactly what "Data & storage" in the README argues for keeping -- but at
# 700MB-1.2GB each they exceed GitHub's hard 100MB-per-file push limit, so
# they're excluded from what actually gets pushed (kept locally only). The
# SPARCL id query cache is excluded for the original, unrelated reason
# (a cache, not informative on its own).
/TABLAS/PARENT/*.fits

# spectra/: per-galaxy (stage 03) and per-stack (stage 10) FITS files are
# regenerated by the pipeline, not tracked -- only the folder skeleton (see
# spectra/README.md). Resume checkpoints are working state, not tracked.
/spectra/singlegalaxies/vd*/*.fits
/spectra/stacks/vd*/*/*/*.fits
/spectra/stacks/vd*/*/*/*.json

# chains/TMJ/: stage 20's MCMC chains are regenerated by the pipeline, not
# tracked -- only the folder skeleton. Raw .h5 chains are deleted by stage
# 20 itself once burned in, but are ignored too in case a run is
# interrupted first.
/chains/TMJ/vd*/*/*/*.txt
/chains/TMJ/vd*/*/*/*.h5

# chains/cosmographic/: stage 30's MCMC chains, same reasoning. Raw .h5 and
# un-burned .txt are deleted by stage 30 itself once burned in.
/chains/cosmographic/*.txt
/chains/cosmographic/*.h5
TABLAS/PARENT/
